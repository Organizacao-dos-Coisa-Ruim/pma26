# Scripts shell sempre com fim de linha LF (Linux), mesmo no Windows: com CRLF o bash do
# WSL/Linux falha com "/usr/bin/env: 'bash\r': No such file or directory".
*.sh text eol=lf
# os *.env.example são copiados para docker/.env e k8s/overlays/*/secrets.env (lidos pelo bash e pelo
# Kustomize): com CRLF as senhas ficariam com "\r" no fim
*.env.example text eol=lf
