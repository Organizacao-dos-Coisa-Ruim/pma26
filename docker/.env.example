# Copie para docker/.env e preencha. O docker/.env NÃO vai para o git.
#   cp docker/.env.example docker/.env

# --- Postgres ---
DATABASE_DB=store
DATABASE_USERNAME=store
# obrigatória
DATABASE_PASSWORD=

# --- Auth ---
# obrigatória, mínimo de 32 caracteres. Gere uma com:
#   openssl rand -base64 48
JWT_SECRET=
JWT_DURATION=1h

# --- Gateway ---
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=*

# --- Observabilidade (http://localhost:3000, usuário admin) ---
# obrigatória
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
