{
  "uid": "pma26-overview",
  "title": "PMA26 - Visão geral",
  "description": "Throughput, latência, erros e recursos por serviço. Pensado para acompanhar o load test.",
  "tags": ["pma26"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Serviço",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requisições por segundo",
      "description": "Taxa de requisições HTTP recebidas (sem contar o /actuator).",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", uri!~\".*actuator.*\"}[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência p95 / p99",
      "description": "Calculada a partir do histograma http.server.requests.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"$application\", uri!~\".*actuator.*\"}[1m])))",
          "legendFormat": "p95 {{application}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"$application\", uri!~\".*actuator.*\"}[1m])))",
          "legendFormat": "p99 {{application}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Respostas por status (gateway)",
      "description": "O que o cliente recebeu: 2xx ok, 4xx (ex.: 401 sem token), 5xx erro.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"gateway\", uri!~\".*actuator.*\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Taxa de erro 5xx",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\", status=~\"5..\"}[1m])) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU do processo",
      "description": "Fração de CPU usada pela JVM de cada serviço. É a métrica que o HPA vai olhar no EKS.",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (application) (process_cpu_usage{application=~\"$application\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memória heap usada",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"$application\", area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conexões do pool com o banco (account)",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{application=\"account\"})", "legendFormat": "ativas" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{application=\"account\"})", "legendFormat": "ociosas" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{application=\"account\"})", "legendFormat": "esperando" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requisições por rota (account e auth)",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_count{application=~\"account|auth\", uri!~\".*actuator.*\"}[1m]))",
          "legendFormat": "{{application}} {{method}} {{uri}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Threads do Tomcat ocupadas (account e auth)",
      "description": "Quando 'ocupadas' encosta no 'máximo', o serviço saturou e as requisições começam a esperar na fila.",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (tomcat_threads_busy_threads{application=~\"account|auth\"})",
          "legendFormat": "ocupadas {{application}}"
        },
        {
          "refId": "B",
          "expr": "max by (application) (tomcat_threads_config_max_threads{application=~\"account|auth\"})",
          "legendFormat": "máximo {{application}}"
        }
      ]
    }
  ]
}
